rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the resource
    function isOwnResource(userId) {
      return request.auth.uid == userId;
    }

    // Shop Profile collection - user can only read/write their own
    match /shop-profile/{userId} {
      allow read, write: if isAuthenticated() && isOwnResource(userId);
    }

    // Purchased Products collection - user can only access their own
    match /purchased-products/{userId}/{document=**} {
      allow read, write: if isAuthenticated() && isOwnResource(userId);
    }

    // Bills collection - user can only access their own
    match /bills/{userId}/{document=**} {
      allow read, write: if isAuthenticated() && isOwnResource(userId);
    }

    // Purchases collection - user can only access their own
    match /purchases/{userId}/{document=**} {
      allow read, write: if isAuthenticated() && isOwnResource(userId);
    }

    // Customers collection - user can only access their own
    match /customers/{userId}/{document=**} {
      allow read, write: if isAuthenticated() && isOwnResource(userId);
    }

    // Units collection - user can only access their own
    match /units/{userId}/{document=**} {
      allow read, write: if isAuthenticated() && isOwnResource(userId);
    }

    // Suppliers collection - user can only access their own
    match /suppliers/{userId}/{document=**} {
      allow read, write: if isAuthenticated() && isOwnResource(userId);
    }

    // Product Names collection - user can only access their own
    match /product-names/{userId}/{document=**} {
      allow read, write: if isAuthenticated() && isOwnResource(userId);
    }

    // Product Purchase History collection - user can only access their own
    match /product-purchase-history/{userId}/{document=**} {
      allow read, write: if isAuthenticated() && isOwnResource(userId);
    }
  }
}
